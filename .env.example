# Public template for local development. Copy to `.env` and adjust paths if needed.
# Ops secrets (admin, mail, push) live only in your private local/.env.example + real `.env` — not in git.

NODE_ENV=development
PORT=3000

DATABASE_PATH=data/wiring.sqlite
DTC_DATABASE_PATH=data/dtc.sqlite
EWD_DATA_DIR=data/ewd
# EWD_SOURCE_DIR=data/ewd/ewd_source/39363002/1/2
MANUAL_DIR=data/ewd
CLIENT_DIST=client/dist

# Telegram Mini App (optional; public browser access still works without these).
# Create the bot in @BotFather, then keep both values only in the VPS `.env`.
# TELEGRAM_BOT_TOKEN=123456:replace-with-real-bot-token
# TELEGRAM_SESSION_SECRET=generate-a-long-random-secret
# TELEGRAM_AUTH_PATH=data/telegram.sqlite
# TELEGRAM_INIT_MAX_AGE_SEC=86400
