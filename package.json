{
  "name": "volvo-xc70-wiring",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,ui -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --config vite.config.ts --port 5173 --strictPort",
    "dev:local": "powershell -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "ai:bootstrap": "powershell -ExecutionPolicy Bypass -File scripts/ai-bootstrap.ps1",
    "ai:new": "powershell -ExecutionPolicy Bypass -File scripts/ai-new-feature.ps1",
    "build": "vite build --config vite.config.ts",
    "start": "tsx server/index.ts",
    "start:full": "node scripts/bootstrap.js",
    "import:manual": "tsx scripts/import-wiring-manual.ts",
    "test": "tsx --test server/**/*.test.ts server/*.test.ts client/src/**/*.test.ts scripts/**/*.test.mjs",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "smoke:nav-plan": "tsx scripts/_smoke-md-nav-plan.mjs",
    "audit:wire-context": "tsx scripts/audit-wire-context.ts",
    "git:save": "node scripts/commit-push.mjs",
    "typecheck": "tsc --noEmit",
    "stamp:updating": "node scripts/stamp-updating.mjs"
  },
  "dependencies": {
    "better-sqlite3": "latest",
    "dotenv": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "nodemailer": "latest",
    "pdf-parse": "latest",
    "pdfjs-dist": "^6.1.200",
    "react": "latest",
    "react-dom": "latest",
    "tsx": "latest",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/better-sqlite3": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/supertest": "latest",
    "@types/web-push": "^3.6.4",
    "concurrently": "latest",
    "playwright": "^1.61.1",
    "supertest": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
